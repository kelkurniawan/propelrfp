# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...

# Email
RESEND_API_KEY=re_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron (any non-empty random string; set the same value in Vercel project settings)
CRON_SECRET=changeme

# Upstash Redis (Vercel KV) — for rate limiting
# Get from Vercel dashboard → your project → Storage → KV → .env.local tab
KV_REST_API_URL=https://your-kv-url.upstash.io
KV_REST_API_TOKEN=your-kv-token

# Sentry — for error monitoring
# Get DSN from sentry.io → your project → Settings → Client Keys
# Get auth token from sentry.io → Settings → Auth Tokens
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oyyy.ingest.sentry.io/zzz
SENTRY_DSN=https://xxxxx@oyyy.ingest.sentry.io/zzz
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=propelrfp
